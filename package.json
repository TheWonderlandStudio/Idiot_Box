{
  "name": "idiot-box",
  "version": "0.1.25",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Idiot Box - Code-OSS-backed desktop IDE built with Electron and React",
  "homepage": "https://thewonderlandstudio.github.io/Idiot_Box/",
  "author": {
    "name": "TheWonderlandStudio",
    "email": "support@thewonderlandstudio.com",
    "url": "https://github.com/TheWonderlandStudio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheWonderlandStudio/Idiot_Box.git"
  },
  "main": "electron/main/index.js",
  "scripts": {
    "build:ai-css": "node build/build-ai-css.cjs",
    "build:preload": "node build/build-preload.cjs",
    "build:renderer": "node build/build-renderer.cjs",
    "build:settings": "esbuild electron/renderer/settings-entry.jsx --bundle --outfile=electron/renderer/settings-bundle.js --platform=browser --loader:.css=css --loader:.jsx=jsx",
    "build": "npm run build:ai-css && npm run build:preload && npm run build:renderer && npm run build:settings",
    "test": "echo \"No tests configured\"",
    "lint": "echo \"No linter configured\"",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win nsis --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@replit/codemirror-vim": "^6.4.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.124",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "custom-electron-titlebar": "^4.4.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.6",
    "flexlayout-react": "^0.8.19",
    "lucide-react": "^1.34.0",
    "motion": "^13.4.6",
    "mqtt": "^5.16.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.thewonderlandstudio.idiotbox",
    "productName": "Idiot Box",
    "copyright": "Copyright © 2026 TheWonderlandStudio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!electron/renderer/**/*.jsx"
    ],
    "extraResources": [
      {
        "from": "electron/renderer/assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Idiot Box",
        "schemes": [
          "idiotbox"
        ]
      }
    ],
    "fileAssociations": [
      { "ext": ["js", "mjs", "cjs", "jsx"], "name": "IdiotBoxJavaScript", "description": "JavaScript source file", "role": "Editor", "mimeType": "text/javascript" },
      { "ext": ["ts", "tsx"], "name": "IdiotBoxTypeScript", "description": "TypeScript source file", "role": "Editor", "mimeType": "text/x-typescript" },
      { "ext": ["html", "htm"], "name": "IdiotBoxHTML", "description": "HTML document", "role": "Editor", "mimeType": "text/html" },
      { "ext": ["css"], "name": "IdiotBoxCSS", "description": "CSS stylesheet", "role": "Editor", "mimeType": "text/css" },
      { "ext": ["scss"], "name": "IdiotBoxSCSS", "description": "SCSS stylesheet", "role": "Editor", "mimeType": "text/x-scss" },
      { "ext": ["less"], "name": "IdiotBoxLESS", "description": "LESS stylesheet", "role": "Editor", "mimeType": "text/x-less" },
      { "ext": ["json", "jsonc"], "name": "IdiotBoxJSON", "description": "JSON document", "role": "Editor", "mimeType": "application/json" },
      { "ext": ["md", "markdown"], "name": "IdiotBoxMarkdown", "description": "Markdown document", "role": "Editor", "mimeType": "text/markdown" },
      { "ext": ["py", "pyw"], "name": "IdiotBoxPython", "description": "Python script", "role": "Editor", "mimeType": "text/x-python" },
      { "ext": ["c", "h"], "name": "IdiotBoxC", "description": "C source file", "role": "Editor", "mimeType": "text/x-csrc" },
      { "ext": ["cpp", "cc", "cxx", "hpp", "hh", "hxx"], "name": "IdiotBoxCpp", "description": "C++ source file", "role": "Editor", "mimeType": "text/x-c++src" },
      { "ext": ["java"], "name": "IdiotBoxJava", "description": "Java source file", "role": "Editor", "mimeType": "text/x-java" },
      { "ext": ["rs"], "name": "IdiotBoxRust", "description": "Rust source file", "role": "Editor", "mimeType": "text/x-rust" },
      { "ext": ["go"], "name": "IdiotBoxGo", "description": "Go source file", "role": "Editor", "mimeType": "text/x-go" },
      { "ext": ["rb"], "name": "IdiotBoxRuby", "description": "Ruby script", "role": "Editor", "mimeType": "text/x-ruby" },
      { "ext": ["php"], "name": "IdiotBoxPHP", "description": "PHP script", "role": "Editor", "mimeType": "text/x-php" },
      { "ext": ["sh", "bash", "zsh"], "name": "IdiotBoxShell", "description": "Shell script", "role": "Editor", "mimeType": "application/x-shellscript" },
      { "ext": ["sql"], "name": "IdiotBoxSQL", "description": "SQL script", "role": "Editor", "mimeType": "text/x-sql" },
      { "ext": ["yml", "yaml"], "name": "IdiotBoxYAML", "description": "YAML document", "role": "Editor", "mimeType": "text/x-yaml" },
      { "ext": ["xml"], "name": "IdiotBoxXML", "description": "XML document", "role": "Editor", "mimeType": "text/xml" },
      { "ext": ["vue"], "name": "IdiotBoxVue", "description": "Vue component", "role": "Editor", "mimeType": "text/x-vue" },
      { "ext": ["svelte"], "name": "IdiotBoxSvelte", "description": "Svelte component", "role": "Editor", "mimeType": "text/x-svelte" },
      { "ext": ["toml"], "name": "IdiotBoxTOML", "description": "TOML configuration file", "role": "Editor", "mimeType": "application/toml" },
      { "ext": ["txt", "log"], "name": "IdiotBoxText", "description": "Plain text document", "role": "Editor", "mimeType": "text/plain" }
    ],
    "asarUnpack": [
      "**/node-pty/**",
      "**/esbuild/**",
      "**/@esbuild/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "publisherName": "TheWonderlandStudio",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Idiot Box",
      "artifactName": "Idiot-Box-Setup-${version}.${ext}",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerHeaderIcon": "electron/renderer/assets/idot_box.png",
      "uninstallDisplayName": "Idiot Box"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "category": "Development",
      "maintainer": "TheWonderlandStudio <support@thewonderlandstudio.com>",
      "description": "Idiot Box - Code-OSS-backed desktop IDE with an embedded extension host",
      "mimeTypes": [
        "text/plain",
        "video/mp2t",
        "application/javascript",
        "text/x-markdown"
      ],
      "desktop": {
        "Name": "Idiot Box",
        "Comment": "Free open-source desktop IDE: code editor, terminal, browser and project map in one window",
        "StartupWMClass": "Idiot Box"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "TheWonderlandStudio",
      "repo": "Idiot_Box",
      "private": false
    }
  }
}
