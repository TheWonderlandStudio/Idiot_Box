{
  "name": "idiot-box",
  "version": "0.1.15",
  "private": true,
  "description": "Idiot Box - VS Code-like editor built with Electron, React and Monaco",
  "author": {
    "name": "TheWonderlandStudio",
    "email": "support@thewonderlandstudio.com",
    "url": "https://github.com/TheWonderlandStudio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheWonderlandStudio/Idiot_Box.git"
  },
  "main": "electron/main/index.js",
  "scripts": {
    "build:workers": "esbuild electron/renderer/workers/editor.worker.entry.js --bundle --outfile=electron/renderer/editor.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/textmate.worker.entry.js --bundle --outfile=electron/renderer/textmate.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/ts.worker.entry.js --bundle --outfile=electron/renderer/ts.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/html.worker.entry.js --bundle --outfile=electron/renderer/html.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/css.worker.entry.js --bundle --outfile=electron/renderer/css.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/json.worker.entry.js --bundle --outfile=electron/renderer/json.worker.js --platform=browser --format=iife && esbuild electron/renderer/workers/ext-host.worker.entry.js --bundle --outfile=electron/renderer/extensionHost.worker.js --platform=browser --format=esm && node build/copy-ext-host-assets.cjs",
    "build:ai-css": "node build/build-ai-css.cjs",
    "build:preload": "node build/build-preload.cjs",
    "build:renderer": "node build/build-renderer.cjs",
    "build:settings": "esbuild electron/renderer/settings-entry.jsx --bundle --outfile=electron/renderer/settings-bundle.js --platform=browser --loader:.css=css --loader:.jsx=jsx",
    "sass:landing": "sass --watch landing-page/styles.scss:landing-page/styles.css",
    "build": "npm run build:ai-css && npm run build:workers && npm run build:preload && npm run build:renderer && npm run build:settings",
    "test": "echo \"No tests configured\"",
    "lint": "echo \"No linter configured\"",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win nsis --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/gateway": "^4.0.75",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/react": "^4.0.96",
    "@codingame/monaco-vscode-api": "^36.0.0",
    "@codingame/monaco-vscode-bat-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-clojure-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-coffeescript-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-cpp-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-csharp-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-css-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-dart-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-diff-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-docker-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-fsharp-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-go-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-groovy-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-handlebars-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-html-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-ini-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-java-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-javascript-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-json-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-julia-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-languages-service-override": "^36.0.0",
    "@codingame/monaco-vscode-less-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-log-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-lua-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-make-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-markdown-math-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-objective-c-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-perl-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-php-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-powershell-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-pug-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-python-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-r-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-razor-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-restructuredtext-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-ruby-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-rust-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-scss-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-shaderlab-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-shellscript-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-sql-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-swift-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-textmate-service-override": "^36.0.0",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-theme-service-override": "^36.0.0",
    "@codingame/monaco-vscode-typescript-basics-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-vb-default-extension": "^36.2.7",
    "@codingame/monaco-vscode-xml-default-extension": "^36.0.0",
    "@codingame/monaco-vscode-yaml-default-extension": "^36.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.93",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.6",
    "flexlayout-react": "^0.8.19",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vscode-icons-js": "^11.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1",
    "sass": "^1.104.0",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.thewonderlandstudio.idiotbox",
    "productName": "Idiot Box",
    "copyright": "Copyright © 2026 TheWonderlandStudio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!electron/renderer/**/*.jsx"
    ],
    "extraResources": [
      {
        "from": "electron/renderer/assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**",
      "**/esbuild/**",
      "**/@esbuild/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "publisherName": "TheWonderlandStudio",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Idiot Box",
      "artifactName": "Idiot-Box-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerHeaderIcon": "electron/renderer/assets/idot_box.png",
      "uninstallDisplayName": "Idiot Box"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "category": "Development",
      "maintainer": "TheWonderlandStudio <support@thewonderlandstudio.com>",
      "description": "Idiot Box - VS Code-like editor built with Electron, React and Monaco",
      "desktop": {
        "Name": "Idiot Box",
        "Comment": "Free open-source desktop IDE: code editor, terminal, browser and project map in one window",
        "StartupWMClass": "Idiot Box"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "TheWonderlandStudio",
      "repo": "Idiot_Box",
      "private": false
    }
  }
}
