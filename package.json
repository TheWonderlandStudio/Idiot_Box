{
  "name": "idiot-box",
  "version": "0.1.16",
  "private": true,
  "description": "Idiot Box - Code-OSS-backed desktop IDE built with Electron and React",
  "author": {
    "name": "TheWonderlandStudio",
    "email": "support@thewonderlandstudio.com",
    "url": "https://github.com/TheWonderlandStudio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheWonderlandStudio/Idiot_Box.git"
  },
  "main": "electron/main/index.js",
  "scripts": {
    "build:ai-css": "node build/build-ai-css.cjs",
    "build:preload": "node build/build-preload.cjs",
    "build:renderer": "node build/build-renderer.cjs",
    "build:settings": "esbuild electron/renderer/settings-entry.jsx --bundle --outfile=electron/renderer/settings-bundle.js --platform=browser --loader:.css=css --loader:.jsx=jsx",
    "sass:landing": "sass --watch landing-page/styles.scss:landing-page/styles.css",
    "build": "npm run build:ai-css && npm run build:preload && npm run build:renderer && npm run build:settings",
    "test": "echo \"No tests configured\"",
    "lint": "echo \"No linter configured\"",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win nsis --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/gateway": "^4.0.75",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/react": "^4.0.96",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.93",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "codemirror": "^6.0.2",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.6",
    "flexlayout-react": "^0.8.19",
    "lucide-react": "^1.34.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vscode-icons-js": "^11.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1",
    "sass": "^1.104.0",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.thewonderlandstudio.idiotbox",
    "productName": "Idiot Box",
    "copyright": "Copyright © 2026 TheWonderlandStudio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!electron/renderer/**/*.jsx"
    ],
    "extraResources": [
      {
        "from": "electron/renderer/assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node-pty/**",
      "**/esbuild/**",
      "**/@esbuild/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "publisherName": "TheWonderlandStudio",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Idiot Box",
      "artifactName": "Idiot-Box-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerHeaderIcon": "electron/renderer/assets/idot_box.png",
      "uninstallDisplayName": "Idiot Box"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/renderer/assets/idot_box.png",
      "category": "Development",
      "maintainer": "TheWonderlandStudio <support@thewonderlandstudio.com>",
      "description": "Idiot Box - Code-OSS-backed desktop IDE with an embedded extension host",
      "desktop": {
        "Name": "Idiot Box",
        "Comment": "Free open-source desktop IDE: code editor, terminal, browser and project map in one window",
        "StartupWMClass": "Idiot Box"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "TheWonderlandStudio",
      "repo": "Idiot_Box",
      "private": false
    }
  }
}
