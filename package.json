{
  "name": "idiot-box",
  "version": "0.1.25",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Idiot Box - Code-OSS-backed desktop IDE built with Electron and React",
  "homepage": "https://thewonderlandstudio.github.io/Idiot_Box/",
  "author": {
    "name": "TheWonderlandStudio",
    "email": "support@thewonderlandstudio.com",
    "url": "https://github.com/TheWonderlandStudio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheWonderlandStudio/Idiot_Box.git"
  },
  "main": "electron/main/index.js",
  "scripts": {
    "build:ai-css": "node build/build-ai-css.cjs",
    "build:preload": "node build/build-preload.cjs",
    "build:renderer": "node build/build-renderer.cjs",
    "build:settings": "esbuild electron/renderer/settings-entry.jsx --bundle --outfile=electron/renderer/settings-bundle.js --platform=browser --loader:.css=css --loader:.jsx=jsx",
    "build:icons": "node build/generate-icons.cjs",
    "build": "npm run build:ai-css && npm run build:preload && npm run build:renderer && npm run build:settings",
    "test": "echo \"No tests configured\"",
    "lint": "echo \"No linter configured\"",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:dir": "npm run build && electron-builder --win nsis --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@excalidraw/excalidraw": "^0.18.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@opencode-ai/sdk": "^1.18.35",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@replit/codemirror-vim": "^6.4.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.124",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "custom-electron-titlebar": "^4.4.1",
    "dompurify": "^3.4.16",
    "electron-chrome-extensions": "^4.9.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.6",
    "flexlayout-react": "^0.8.19",
    "lucide-react": "^1.34.0",
    "marked": "^18.1.0",
    "motion": "^13.4.6",
    "mqtt": "^5.16.0",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "opencode-ai": "^1.18.35",
    "prettier": "^3.9.10",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "vscode-icons-js": "^11.6.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.thewonderlandstudio.idiotbox",
    "productName": "Idiot Box",
    "copyright": "Copyright © 2026 TheWonderlandStudio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!electron/renderer/**/*.jsx"
    ],
    "extraResources": [
      {
        "from": "electron/renderer/assets/",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Idiot Box",
        "schemes": [
          "idiotbox"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "js",
          "mjs",
          "cjs"
        ],
        "name": "IdiotBoxJavaScript",
        "icon": "file-icons/js.ico",
        "description": "JavaScript source file",
        "role": "Editor",
        "mimeType": "text/javascript"
      },
      {
        "ext": [
          "jsx"
        ],
        "name": "IdiotBoxReact",
        "icon": "file-icons/react.ico",
        "description": "JSX component",
        "role": "Editor",
        "mimeType": "text/javascript"
      },
      {
        "ext": [
          "ts"
        ],
        "name": "IdiotBoxTypeScript",
        "icon": "file-icons/ts.ico",
        "description": "TypeScript source file",
        "role": "Editor",
        "mimeType": "text/x-typescript"
      },
      {
        "ext": [
          "tsx"
        ],
        "name": "IdiotBoxReactTS",
        "icon": "file-icons/reactts.ico",
        "description": "TSX component",
        "role": "Editor",
        "mimeType": "text/x-typescript"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "IdiotBoxHTML",
        "icon": "file-icons/html.ico",
        "description": "HTML document",
        "role": "Editor",
        "mimeType": "text/html"
      },
      {
        "ext": [
          "css"
        ],
        "name": "IdiotBoxCSS",
        "icon": "file-icons/css.ico",
        "description": "CSS stylesheet",
        "role": "Editor",
        "mimeType": "text/css"
      },
      {
        "ext": [
          "scss"
        ],
        "name": "IdiotBoxSCSS",
        "icon": "file-icons/scss.ico",
        "description": "SCSS stylesheet",
        "role": "Editor",
        "mimeType": "text/x-scss"
      },
      {
        "ext": [
          "less"
        ],
        "name": "IdiotBoxLESS",
        "icon": "file-icons/less.ico",
        "description": "LESS stylesheet",
        "role": "Editor",
        "mimeType": "text/x-less"
      },
      {
        "ext": [
          "json",
          "jsonc"
        ],
        "name": "IdiotBoxJSON",
        "icon": "file-icons/json.ico",
        "description": "JSON document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "IdiotBoxMarkdown",
        "icon": "file-icons/md.ico",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "py",
          "pyw"
        ],
        "name": "IdiotBoxPython",
        "icon": "file-icons/py.ico",
        "description": "Python script",
        "role": "Editor",
        "mimeType": "text/x-python"
      },
      {
        "ext": [
          "c"
        ],
        "name": "IdiotBoxC",
        "icon": "file-icons/c.ico",
        "description": "C source file",
        "role": "Editor",
        "mimeType": "text/x-csrc"
      },
      {
        "ext": [
          "h"
        ],
        "name": "IdiotBoxCHeader",
        "icon": "file-icons/cheader.ico",
        "description": "C header file",
        "role": "Editor",
        "mimeType": "text/x-chdr"
      },
      {
        "ext": [
          "cpp",
          "cc",
          "cxx"
        ],
        "name": "IdiotBoxCpp",
        "icon": "file-icons/cpp.ico",
        "description": "C++ source file",
        "role": "Editor",
        "mimeType": "text/x-c++src"
      },
      {
        "ext": [
          "hpp",
          "hh",
          "hxx"
        ],
        "name": "IdiotBoxCppHeader",
        "icon": "file-icons/cppheader.ico",
        "description": "C++ header file",
        "role": "Editor",
        "mimeType": "text/x-c++hdr"
      },
      {
        "ext": [
          "java"
        ],
        "name": "IdiotBoxJava",
        "icon": "file-icons/java.ico",
        "description": "Java source file",
        "role": "Editor",
        "mimeType": "text/x-java"
      },
      {
        "ext": [
          "rs"
        ],
        "name": "IdiotBoxRust",
        "icon": "file-icons/rust.ico",
        "description": "Rust source file",
        "role": "Editor",
        "mimeType": "text/x-rust"
      },
      {
        "ext": [
          "go"
        ],
        "name": "IdiotBoxGo",
        "icon": "file-icons/go.ico",
        "description": "Go source file",
        "role": "Editor",
        "mimeType": "text/x-go"
      },
      {
        "ext": [
          "rb"
        ],
        "name": "IdiotBoxRuby",
        "icon": "file-icons/ruby.ico",
        "description": "Ruby script",
        "role": "Editor",
        "mimeType": "text/x-ruby"
      },
      {
        "ext": [
          "php"
        ],
        "name": "IdiotBoxPHP",
        "icon": "file-icons/php.ico",
        "description": "PHP script",
        "role": "Editor",
        "mimeType": "text/x-php"
      },
      {
        "ext": [
          "sh",
          "bash",
          "zsh"
        ],
        "name": "IdiotBoxShell",
        "icon": "file-icons/shell.ico",
        "description": "Shell script",
        "role": "Editor",
        "mimeType": "application/x-shellscript"
      },
      {
        "ext": [
          "sql"
        ],
        "name": "IdiotBoxSQL",
        "icon": "file-icons/sql.ico",
        "description": "SQL script",
        "role": "Editor",
        "mimeType": "text/x-sql"
      },
      {
        "ext": [
          "yml",
          "yaml"
        ],
        "name": "IdiotBoxYAML",
        "icon": "file-icons/yaml.ico",
        "description": "YAML document",
        "role": "Editor",
        "mimeType": "text/x-yaml"
      },
      {
        "ext": [
          "xml"
        ],
        "name": "IdiotBoxXML",
        "icon": "file-icons/xml.ico",
        "description": "XML document",
        "role": "Editor",
        "mimeType": "text/xml"
      },
      {
        "ext": [
          "vue"
        ],
        "name": "IdiotBoxVue",
        "icon": "file-icons/vue.ico",
        "description": "Vue component",
        "role": "Editor",
        "mimeType": "text/x-vue"
      },
      {
        "ext": [
          "svelte"
        ],
        "name": "IdiotBoxSvelte",
        "icon": "file-icons/svelte.ico",
        "description": "Svelte component",
        "role": "Editor",
        "mimeType": "text/x-svelte"
      },
      {
        "ext": [
          "toml"
        ],
        "name": "IdiotBoxTOML",
        "icon": "file-icons/toml.ico",
        "description": "TOML configuration file",
        "role": "Editor",
        "mimeType": "application/toml"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "IdiotBoxText",
        "icon": "file-icons/txt.ico",
        "description": "Plain text document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "log"
        ],
        "name": "IdiotBoxLog",
        "icon": "file-icons/log.ico",
        "description": "Log file",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "asarUnpack": [
      "**/node-pty/**",
      "**/esbuild/**",
      "**/@esbuild/**",
      "**/node_modules/opencode-ai/bin/**",
      "**/node_modules/opencode-windows-*/**",
      "**/node_modules/opencode-linux-*/**",
      "**/node_modules/opencode-darwin-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons/icon.ico",
      "publisherName": "TheWonderlandStudio",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "signingHashAlgorithms": ["sha256"],
      "sign": null,
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Idiot Box",
      "artifactName": "Idiot-Box-Setup-${version}.${ext}",
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerHeaderIcon": "build/icons/icon.ico",
      "uninstallDisplayName": "Idiot Box",
      "include": "build/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "afterSign": "build/notarize.cjs"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons/icon.png",
      "category": "Development",
      "maintainer": "TheWonderlandStudio <support@thewonderlandstudio.com>",
      "description": "Idiot Box - Code-OSS-backed desktop IDE with an embedded extension host",
      "mimeTypes": [
        "text/plain",
        "video/mp2t",
        "application/javascript",
        "text/x-markdown"
      ],
      "desktop": {
        "Name": "Idiot Box",
        "Comment": "Free open-source desktop IDE: code editor, terminal, browser and project map in one window",
        "StartupWMClass": "Idiot Box"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "TheWonderlandStudio",
      "repo": "Idiot_Box",
      "private": false
    }
  }
}
