# Code Signing — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.signing and fill in your values.
# NEVER commit .env.signing to git — it's already in .gitignore.
#
# Load before building:
#   Windows PowerShell:  Get-Content .env.signing | ForEach-Object { $k,$v = $_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k,$v,'Process') }
#   macOS/Linux bash:    set -a; source .env.signing; set +a
# ─────────────────────────────────────────────────────────────────────────────

# ── Windows Authenticode (Code Signing Certificate) ──────────────────────────
# Obtain a certificate from DigiCert, Sectigo, or GlobalSign.
# electron-builder reads CSC_LINK + CSC_KEY_PASSWORD automatically.

# Path to your .pfx/.p12 certificate, or base64-encoded certificate for CI:
CSC_LINK=

# Password for the .pfx/.p12 certificate:
CSC_KEY_PASSWORD=

# Optionally override the publisher name embedded in the signature:
# WIN_CSC_LINK=       (alias for CSC_LINK on Windows only)
# WIN_CSC_KEY_PASSWORD= (alias for CSC_KEY_PASSWORD on Windows only)

# ── macOS Notarization (Apple Notary Service) ─────────────────────────────────
# 1. Your Apple ID (the email you log in with at appleid.apple.com):
APPLE_ID=

# 2. App-Specific Password — create one at https://appleid.apple.com > App-Specific Passwords:
APPLE_APP_SPECIFIC_PASSWORD=

# 3. Your 10-character Developer Team ID (Xcode > Preferences > Accounts):
APPLE_TEAM_ID=
